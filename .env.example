POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms
SECRET_KEY=replace-with-a-random-local-secret
JWT_SECRET_KEY=replace-with-a-separate-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=900
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://cms:cms@db:5432/cms
VITE_API_BASE_URL=http://localhost:5000/api
SEED_SUPERADMIN_EMAIL=superadmin@example.test
SEED_SUPERADMIN_PASSWORD=replace-with-a-local-password
MEDIA_STORAGE_ROOT=/var/lib/cms/media
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PIXELS=40000000
